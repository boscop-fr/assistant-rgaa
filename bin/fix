#!/usr/bin/env node
import fs from 'fs';
import path from 'path';
import {parseArgs} from 'util';

const usage = 'Usage: bin/fix reference -n <reference> [-d <dest>]';

const {
	positionals: [command],
	values: {name, dest}
} = parseArgs({
	allowPositionals: true,
	options: {
		name: {type: 'string', short: 'n'},
		dest: {
			type: 'string',
			short: 'd',
			default: path.resolve(import.meta.dirname, '../data/references')
		}
	}
});

if (command !== 'reference' && command !== 'r') {
	console.log(usage);
	process.exit(1);
}

/**
 * Fixes reference.
 */
const referencePath = path.join(dest, `${name}.json`);
const reference = JSON.parse(fs.readFileSync(referencePath, 'utf-8'));

const fixed = {
	...reference,
	themes: reference.themes.map((theme) => ({
		...theme,
		criteria: theme.criteria
			.filter((criterion) => criterion.id.startsWith(`${theme.id}.`))
			.map((criterion) => ({
				...criterion,
				tests: criterion.tests.filter((test) =>
					test.id.startsWith(`${criterion.id}.`)
				)
			}))
	}))
};

fs.writeFileSync(referencePath, JSON.stringify(fixed, null, '\t'));
